# Template only. Server entries live in the private backup (pen drive), not in this public repo.
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

# Second GitHub account (WhitesenseAI). IdentitiesOnly makes ssh offer only this key.
Host github-whitesense
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_whitesense
  IdentitiesOnly yes
